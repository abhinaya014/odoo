<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ropalmi_purchase_form" model="ir.ui.view">
    <field name="name">ropalmi.purchase.form</field>
    <field name="model">ropalmi.purchase</field>
    <field name="arch" type="xml">
        <form>
            <header>
                <button name="action_confirm" string="Confirmar" type="object" class="oe_highlight" states="draft"/>
                <button name="action_receive" string="Recibir" type="object" class="oe_highlight" states="confirmed"/>
                <button name="action_cancel" string="Cancelar" type="object" states="draft,confirmed"/>
                <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,received"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <h1><field name="name" readonly="1"/></h1>
                </div>
                <group>
                    <group>
                        <field name="supplier"/>
                        <field name="date"/>
                    </group>
                </group>
                <notebook>
                    <page string="Productos">
                        <field name="purchase_lines">
                            <tree editable="bottom">
                                <field name="product_id"/>
                                <field name="quantity"/>
                                <field name="price"/>
                                <field name="subtotal" sum="Total"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <group class="oe_subtotal_footer">
                    <field name="total" widget="monetary"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

<record id="view_ropalmi_purchase_tree" model="ir.ui.view">
    <field name="name">ropalmi.purchase.tree</field>
    <field name="model">ropalmi.purchase</field>
    <field name="arch" type="xml">
        <tree>
            <field name="name"/>
            <field name="date"/>
            <field name="supplier"/>
            <field name="total" sum="Total"/>
            <field name="state"/>
        </tree>
    </field>
</record>

<record id="action_ropalmi_purchase" model="ir.actions.act_window">
    <field name="name">Compras</field>
    <field name="res_model">ropalmi.purchase</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem id="menu_ropalmi_purchase"
    name="Compras"
    parent="menu_ropalmi_root"
    action="action_ropalmi_purchase"
    sequence="30"/>
</odoo>
