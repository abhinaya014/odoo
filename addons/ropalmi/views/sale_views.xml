<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ropalmi_sale_form" model="ir.ui.view">
        <field name="name">ropalmi.sale.form</field>
        <field name="model">ropalmi.sale</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirmar" type="object" class="oe_highlight" states="draft"/>
                    <button name="action_done" string="Realizar" type="object" class="oe_highlight" states="confirmed"/>
                    <button name="action_cancel" string="Cancelar" type="object" states="draft,confirmed"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="customer"/>
                        <field name="date"/>
                    </group>
                    <notebook>
                        <page string="Líneas de Venta">
                            <field name="sale_lines">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price"/>
                                    <field name="subtotal" sum="Total"/>
                                </tree>
                                <form>
                                    <group>
                                        <field name="product_id"/>
                                        <field name="quantity"/>
                                        <field name="price"/>
                                        <field name="subtotal"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer">
                        <field name="total"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
