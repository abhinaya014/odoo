<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_ropalmi_sale">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Venta <span t-field="o.name"/></h2>
                    
                    <div class="row mt32 mb32">
                        <div class="col-6">
                            <strong>Cliente:</strong>
                            <span t-field="o.customer"/>
                        </div>
                        <div class="col-6">
                            <strong>Fecha:</strong>
                            <span t-field="o.date"/>
                        </div>
                    </div>

                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th class="text-right">Cantidad</th>
                                <th class="text-right">Precio</th>
                                <th class="text-right">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.sale_lines" t-as="line">
                                <td><span t-field="line.product_id.name"/></td>
                                <td class="text-right"><span t-field="line.quantity"/></td>
                                <td class="text-right"><span t-field="line.price"/></td>
                                <td class="text-right"><span t-field="line.subtotal"/></td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-right"><strong>Total</strong></td>
                                <td class="text-right"><span t-field="o.total"/></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </t>
</template>

<record id="action_report_ropalmi_sale" model="ir.actions.report">
    <field name="name">Informe de Venta</field>
    <field name="model">ropalmi.sale</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">ropalmi.report_ropalmi_sale</field>
    <field name="report_file">ropalmi.report_ropalmi_sale</field>
    <field name="binding_model_id" ref="model_ropalmi_sale"/>
    <field name="binding_type">report</field>
</record>
</odoo>
